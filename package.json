{
  "name": "guestly",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/landing",
    "apps/product"
  ],
  "scripts": {
    "dev:landing": "npm --prefix apps/landing run dev",
    "dev:product": "npm --prefix apps/product run dev",
    "build:landing": "npm --prefix apps/landing run build",
    "build:product": "npm --prefix apps/product run build",
    "build": "npm run build:landing",
    "build:all": "npm run build:landing && npm run build:product",
    "launch:check": "npm --prefix apps/product run launch:check"
  }
}
