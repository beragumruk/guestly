{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/landing/dist",
  "rewrites": [
    {
      "source": "/trust",
      "destination": "/trust.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/demo",
      "destination": "/demo.html"
    },
    {
      "source": "/impact",
      "destination": "/impact.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/product",
      "destination": "/product.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    }
  ]
}
